generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      GroupMember[]
  paidExpenses     Expense[]     @relation("PaidBy")
  expenseSplits    ExpenseSplit[]
  sentPayments     Settlement[]  @relation("Payer")
  receivedPayments Settlement[]  @relation("Payee")
  activities       Activity[]
  refreshTokens    RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  emoji       String   @default("💰")
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  activities  Activity[]
}

model GroupMember {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Expense {
  id                 String   @id @default(cuid())
  groupId            String
  paidById           String
  title              String
  amount             Float
  currency           String   @default("USD")
  category           String   @default("other")
  notes              String?
  receiptUrl         String?
  date               DateTime @default(now())
  splitType          String   @default("equal")
  isRecurring        Boolean  @default(false)
  recurringFrequency String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy User           @relation("PaidBy", fields: [paidById], references: [id])
  splits ExpenseSplit[]
}

model ExpenseSplit {
  id        String @id @default(cuid())
  expenseId String
  userId    String
  amount    Float
  shares    Float  @default(1)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

model Settlement {
  id        String   @id @default(cuid())
  groupId   String
  payerId   String
  payeeId   String
  amount    Float
  currency  String   @default("USD")
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer User  @relation("Payer", fields: [payerId], references: [id])
  payee User  @relation("Payee", fields: [payeeId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  type      String
  data      String   @db.Text
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])
}
